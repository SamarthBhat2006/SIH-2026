# NTRO AI Content Transformation Platform Environment Configuration

# Optional: Google Gemini API Key (Default recommended provider)
GEMINI_API_KEY=

# Optional: OpenAI API Key (Alternative provider)
OPENAI_API_KEY=

# AI Provider Selection: "auto", "gemini", "openai", or "offline_simulation"
AI_PROVIDER=auto

# Security Thresholds
STRICT_INJECTION_BLOCKING=false
ENABLE_SENSITIVE_DATA_MASKING=false

# Application Settings
APP_PORT=8501
DB_PATH=data/transformations.db
LEDGER_PATH=data/blockchain_ledger.json
